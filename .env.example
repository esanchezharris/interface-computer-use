# No automatic .env loading. Export only project-authorized configuration.
# Presence of a key alone never authorizes calls. No default model or paid budget.
OPENAI_API_KEY=
CUA_MODEL=
CUA_API_APPROVED=false
CUA_MAX_CALLS=
CUA_MAX_TOTAL_TOKENS=
# A per-request output bound, counted with a conservative input reservation.
CUA_MAX_OUTPUT_TOKENS=1000
# Explicit unique budget ID; reservations persist in ignored .runs/budgets/.
CUA_BUDGET_ID=
